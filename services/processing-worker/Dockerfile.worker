FROM node:22-bookworm-slim

# Native/OCR runtime libs for @napi-rs/canvas and tesseract.js, plus virtual display for ODA File Converter.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 ca-certificates curl xvfb libfontconfig1 libfreetype6 \
      build-essential autoconf automake libtool pkg-config git texinfo \
    && rm -rf /var/lib/apt/lists/*

# GNU LibreDWG (dwg2dxf) built from a pinned release tag. GPLv3. Supports a subset of DWG versions.
ARG LIBREDWG_REF=0.13.3
RUN git clone --depth 1 --branch ${LIBREDWG_REF} https://github.com/LibreDWG/libredwg.git /tmp/libredwg \
    && cd /tmp/libredwg && sh autogen.sh && ./configure --disable-bindings --disable-werror && make -j2 && make install && ldconfig \
    && rm -rf /tmp/libredwg

# To use ODA File Converter instead: download the .deb from opendesign.com (licence required for commercial use),
# COPY it in, `dpkg -i`, and set DWG_CONVERTER=oda DWG_CONVERTER_PATH=/usr/bin/ODAFileConverter DWG_CONVERTER_XVFB=1.

ENV NODE_ENV=production DWG_CONVERTER=libredwg DWG_CONVERTER_PATH=/usr/local/bin/dwg2dxf PORT=8080
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY src ./src
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fsS http://localhost:8080/health || exit 1
CMD ["node", "src/server.mjs"]
